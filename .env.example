# Secret used to sign sessions. If unset, one is generated in server/data/.jwt-secret
JWT_SECRET=
PORT=8787
DATA_DIR=./server/data

# Public URL users open (used in email links). Dev: http://localhost:5173
APP_URL=http://localhost:5173

# Email (SMTP). Leave SMTP_HOST empty to print emails to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SHAFARE <no-reply@yourdomain.com>

# Google sign-in: OAuth "Web application" client ID from console.cloud.google.com
# Add your APP_URL (and http://localhost:5173) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Native app (Capacitor) or a frontend hosted separately from the API.
# Put this in .env.production before building the app: VITE_API_URL=https://your-server.example.com
VITE_API_URL=
# Extra origins allowed to call the API (comma separated), e.g. https://shafare.app
CORS_ORIGINS=

# ---- SHAFARE security and admin ----
# Comma-separated emails that become SUPERADMIN (must be a verified address). Everything else is managed in SHAFARE ADMIN.
SUPERADMIN_EMAILS=
# Behind a reverse proxy / load balancer (Render, Fly, Nginx...) set to the number of proxies (usually 1) so rate limiting sees real client IPs.
TRUST_PROXY=
# Set to production when deployed: enables Secure cookies and HSTS.
NODE_ENV=development
# JWT_SECRET must be at least 32 characters if you set it.
