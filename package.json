{
  "name": "shafare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "dev:all": "concurrently -n web,api \"vite\" \"node --env-file-if-exists=.env --watch server/index.js\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "typecheck": "tsc --noEmit",
    "app:android:add": "cap add android && node scripts/patch-android.mjs && capacitor-assets generate --android",
    "app:android": "npm run build && cap sync android && cap open android",
    "app:ios:add": "cap add ios && capacitor-assets generate --ios",
    "app:ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^0.446.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5",
    "express": "^4.21.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "google-auth-library": "^9.14.1",
    "pdfjs-dist": "^4.6.82",
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "concurrently": "^9.0.1",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/assets": "^3.0.5"
  }
}